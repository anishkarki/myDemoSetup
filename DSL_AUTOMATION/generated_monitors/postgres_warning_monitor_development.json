{
  "type": "monitor",
  "name": "Postgres Warning Monitor - Development",
  "enabled": false,
  "schedule": {
    "period": {
      "interval": 5,
      "unit": "MINUTES"
    }
  },
  "inputs": [
    {
      "search": {
        "indices": [
          "postgresdata"
        ],
        "query": {
          "query": {
            "bool": {
              "should": [
                {
                  "match_phrase": {
                    "_raw": "WARNING"
                  }
                },
                {
                  "match_phrase": {
                    "_raw": "ERROR"
                  }
                }
              ],
              "minimum_should_match": 1
            }
          },
          "size": 50
        }
      }
    }
  ],
  "triggers": [
    {
      "name": "Warning Trigger",
      "severity": "3",
      "condition": {
        "script": {
          "source": "return ctx.results != null && ctx.results[0].hits.total.value > 5;",
          "lang": "painless"
        }
      },
      "actions": [
        {
          "name": "Email Warning",
          "destination_id": "yZI4WJoBHocox8i_xA-r",
          "subject_template": {
            "source": "Postgres Warning: {{ctx.monitor.name}}"
          },
          "message_template": {
            "source": "<html><head><meta charset=\"utf-8\">\n<style>body{font-family:Arial,Helvetica,sans-serif;color:#222}table{border-collapse:collapse;width:100%;font-size:13px}th,td{border:1px solid #ddd;padding:6px;vertical-align:top}th{background:#f2f2f2;text-align:left}td.log{font-family:Menlo,Consolas,monospace;white-space:pre-wrap;word-break:break-word}</style>\n</head><body><p><strong>Monitor:</strong> {{ctx.monitor.name}}<br/><strong>Trigger:</strong> {{ctx.trigger.name}}<br/><strong>Total hits:</strong> {{ctx.results[0].hits.total.value}}</p><table><thead><tr><th>Timestamp</th><th>Hostname</th><th>Log</th></tr></thead><tbody>{{#ctx.results.0.hits.hits}}<tr><td>{{_source.@timestamp}}</td><td>{{_source.host.name}}</td><td class=\"log\">{{{_source._raw}}}</td></tr>{{/ctx.results.0.hits.hits}}</tbody></table></body></html>",
            "lang": "mustache"
          },
          "throttle_enabled": true,
          "throttle": {
            "value": 30,
            "unit": "MINUTES"
          }
        }
      ]
    }
  ]
}