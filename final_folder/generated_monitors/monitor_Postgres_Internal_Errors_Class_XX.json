{
  "type": "monitor",
  "name": "Postgres Internal Errors (Class XX)",
  "monitor_type": "query_level_monitor",
  "enabled": true,
  "schedule": {
    "period": {
      "interval": 5,
      "unit": "MINUTES"
    }
  },
  "inputs": [
    {
      "search": {
        "indices": [
          "patronidata"
        ],
        "query": {
          "query": {
            "bool": {
              "must": [
                {
                  "range": {
                    "@timestamp": {
                      "gte": "now-5m",
                      "lte": "now"
                    }
                  }
                },
                {
                  "bool": {
                    "should": [
                      {
                        "match_phrase": {
                          "_raw": "FATAL"
                        }
                      },
                      {
                        "match_phrase": {
                          "_raw": "PANIC"
                        }
                      }
                    ],
                    "minimum_should_match": 1
                  }
                },
                {
                  "wildcard": {
                    "_raw": {
                      "value": "*xx???*",
                      "case_insensitive": true
                    }
                  }
                }
              ]
            }
          },
          "size": 10,
          "sort": [
            {
              "@timestamp": {
                "order": "desc"
              }
            }
          ]
        }
      }
    }
  ],
  "triggers": [
    {
      "name": "Internal Error Trigger",
      "severity": "1",
      "condition": {
        "script": {
          "lang": "painless",
          "source": "ctx.results[0].hits.total.value > 0"
        }
      },
      "actions": [
        {
          "name": "Send Email Action",
          "destination_id": "yZI4WJoBHocox8i_xA-r",
          "message_template": {
            "source": "Monitor {{ctx.monitor.name}} just entered alert status.\nHits: {{ctx.results[0].hits.total.value}}\n\nLogs:\n{{#ctx.results[0].hits.hits}}\n- {{_source._raw}}\n{{/ctx.results[0].hits.hits}}\n",
            "lang": "mustache"
          },
          "subject_template": {
            "source": "CRITICAL: Postgres Internal Error Detected",
            "lang": "mustache"
          }
        }
      ]
    }
  ]
}