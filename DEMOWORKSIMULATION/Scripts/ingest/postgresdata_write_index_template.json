{
  "index_patterns": ["postgresdata-*"],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1
    },
    "mappings": {
      "properties": {
        "postgres": { "properties": { "sqlstate": { "type": "keyword" } } },
        "host": { "properties": { "name": { "type": "keyword" } } },
        "@timestamp": { "type": "date" },
        "_raw": { "type": "text" }
      }
    },
    "aliases": {
      "postgresdata-write": {}
    }
  }
}
