FROM postgres:16

# Install Python and Patroni dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-psycopg2 \
    python3-etcd \
    && rm -rf /var/lib/apt/lists/*

# Install Patroni
RUN pip3 install --break-system-packages patroni[etcd3]

# Create log directory
RUN mkdir -p /var/log/postgresql && chown postgres:postgres /var/log/postgresql

# Create patroni config directory
RUN mkdir -p /etc/patroni

USER postgres

ENTRYPOINT []
CMD ["/usr/local/bin/patroni"]
