{
  "query": {
    "bool": {
      "must": [
        {
          "range": {
            "@timestamp": {
              "gte": "2025-11-25T04:42:00",
              "lte": "2025-11-25T04:42:10"
            }
          }
        },
        {
          "wildcard": {
            "source": "postgres*"
          }
        }
      ],
      "should": [
        {
          "match_phrase": {
            "message": "replication terminated by primary server"
          }
        },
        {
          "match_phrase": {
            "message": "End of WAL reached on timeline"
          }
        },
        {
          "match_phrase": {
            "message": "could not send end-of-streaming message to primary"
          }
        },
        {
          "match_phrase": {
            "message": "could not connect to the primary server"
          }
        },
        {
          "match_phrase": {
            "message": "received promote request"
          }
        },
        {
          "match_phrase": {
            "message": "redo done at"
          }
        },
        {
          "match_phrase": {
            "message": "selected new timeline ID"
          }
        },
        {
          "match_phrase": {
            "message": "archive recovery complete"
          }
        },
        {
          "match_phrase": {
            "message": "database system is ready to accept connections"
          }
        },
        {
          "match": {
            "message": {
              "query": "promote timeline recovery complete ready to accept",
              "operator": "or"
            }
          }
        }
      ],
      "minimum_should_match": 1
    }
  },
  "sort": [
    {
      "@timestamp": {
        "order": "asc"
      }
    }
  ],
  "size": 100,
  "_source": ["@timestamp", "message", "source", "level", "container_name", "host"],
  "highlight": {
    "fields": {
      "message": {
        "fragment_size": 300,
        "number_of_fragments": 1
      }
    }
  }
}
