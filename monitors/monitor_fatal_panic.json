{
  "type": "monitor",
  "name": "fatal_panic",
  "monitor_type": "query_level_monitor",
  "enabled": true,
  "schedule": {
    "period": {
      "interval": 1,
      "unit": "MINUTES"
    }
  },
  "inputs": [
    {
      "search": {
        "indices": [
          "postgres*"
        ],
        "query": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                {
                  "range": {
                    "@timestamp": {
                      "gte": "now-1m"
                    }
                  }
                },
                {
                  "wildcard": {
                    "host.name.keyword": "87b4cc23*"
                  }
                }
              ],
              "should": [
                {
                  "match": {
                    "_raw": "FATAL"
                  }
                },
                {
                  "match": {
                    "_raw": "PANIC"
                  }
                }
              ],
              "minimum_should_match": 1
            }
          },
          "aggs": {
            "count": {
              "value_count": {
                "field": "_id"
              }
            },
            "sample_logs": {
              "top_hits": {
                "size": 3,
                "_source": [
                  "@timestamp",
                  "_raw",
                  "host",
                  "pid"
                ],
                "sort": [
                  {
                    "@timestamp": {
                      "order": "desc"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "triggers": [
    {
      "query_level_trigger": {
        "name": "fatal_panic trigger",
        "severity": "1",
        "condition": {
          "script": {
            "source": "try {\n  def v = ctx.results[0].aggregations.count.value;\n  return v >= 1;\n} catch (Exception e) {\n  return false;\n}",
            "lang": "painless"
          }
        },
        "actions": [
          {
            "name": "Send Alert",
            "destination_id": "your_webhook_config_id",
            "subject_template": {
              "source": "fatal_panic"
            },
            "message_template": {
              "source": "{\n  \"test_recepient\": \"abc@mail.com\",\n  \"prod_recepient\": \"abc@mail.com\",\n  \"header\": \"all alert\",\n  \"message\": \"<h2>{{ctx.monitor.name}}</h2>\\n<p>Severity: {{ctx.trigger.severity}}</p>\\n<p>Count: {{ctx.results[0].aggregations.count.value}}</p>\\n<p>Time: {{ctx.trigger.triggered_time}}</p>\\n<h3>Hosts</h3>\\n<table border='1' cellpadding='6' cellspacing='0' style='border-collapse:collapse'>\\n  <tr><th>Host</th><th>Count</th></tr>\\n  {{#ctx.results[0].aggregations.by_host.buckets}}\\n    <tr><td>{{key}}</td><td>{{doc_count}}</td></tr>\\n  {{/ctx.results[0].aggregations.by_host.buckets}}\\n</table>\\n<h3>Sample Logs</h3>\\n<table border='1' cellpadding='6' cellspacing='0' style='border-collapse:collapse'>\\n  <tr><th>Time</th><th>Log</th></tr>\\n  {{#ctx.results[0].aggregations.sample_logs.hits.hits}}\\n    <tr><td>{{_source.@timestamp}}</td><td>{{{_source._raw}}}</td></tr>\\n  {{/ctx.results[0].aggregations.sample_logs.hits.hits}}\\n</table>\"\n}",
              "lang": "mustache"
            },
            "throttle_enabled": false
          }
        ]
      }
    }
  ]
}